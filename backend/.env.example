# ---- Server ----
PORT=4000
NODE_ENV=development

# Allowed frontend origins (CORS). Comma-separate multiple values.
# Supports exact origins and wildcard subdomains. For a Lovable frontend, add its preview
# domain wildcard, e.g.:
#   FRONTEND_ORIGIN=http://localhost:5173,https://your-app.lovable.app,*.lovableproject.com
FRONTEND_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL / Supabase) ----
# Local example:   postgresql://postgres:postgres@localhost:5432/feesup?schema=public
# Supabase: copy the "Connection string" (URI) from Project Settings > Database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feesup?schema=public

# ---- Auth ----
# Use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---- Provider selection (mock | live) ----
# Phase 0/1 run entirely on mock. Switch to live once credentials/approvals are ready.
PAYMENT_PROVIDER=mock
MESSAGING_PROVIDER=mock

# ---- Razorpay (Phase 2, only needed when PAYMENT_PROVIDER=live) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- PayPerWA (Phase 3, only needed when MESSAGING_PROVIDER=live) ----
PAYPERWA_API_KEY=
PAYPERWA_BASE_URL=

# ---- Internal jobs ----
# Secret required in the `x-internal-secret` header to trigger scheduled jobs.
INTERNAL_JOB_SECRET=change-me-internal-secret
